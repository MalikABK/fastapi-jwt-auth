# FastAPI JWT Authentication Service - Environment Variables

# Application Configuration
APP_NAME=FastAPI JWT Authentication Service
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/fastapi_auth

# JWT Configuration (REQUIRED)
# Generate a strong secret key with at least 32 characters
# Example: openssl rand -hex 32
JWT_SECRET_KEY=generate-a-very-long-secret-key-with-at-least-32-characters-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security Configuration
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Email Configuration (Choose one: SMTP, Unosend, or Mailgun)
# For Gmail/Standard SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_SENDER=your-email@gmail.com

# For Unosend SMTP (uncomment and configure as needed):
SMTP_HOST=smtp.unosend.co
SMTP_USERNAME=unosend
SMTP_PASSWORD=your_unosend_api_key
UNOSEND_TRACK_OPENS=false
UNOSEND_TRACK_CLICKS=false
UNOSEND_TAGS=registration,verification

# For Mailgun (alternative to SMTP):
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_SENDER=

# For Resend (alternative to SMTP and Mailgun):
# RESEND_API_KEY=
# RESEND_SENDER=onboarding@resend.dev

# Application Settings
FRONTEND_URL=http://localhost:3000
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=AdminPass123!

# Debugging (set to False in production)
DEBUG=False