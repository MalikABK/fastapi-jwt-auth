# FastAPI JWT Authentication Service - Environment Variables

# Application Configuration
APP_NAME=FastAPI JWT Authentication Service
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/fastapi_auth

# JWT Configuration
# Generate a strong secret key with at least 32 characters
# Example: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-and-long-key-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Development/Debugging
DEBUG=False
LOG_LEVEL=INFO

# Rate Limiting (if using Redis)
REDIS_URL=redis://localhost:6379/0